{
  "name": "stanza-benchmark-harness",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Reproducible benchmark for the Stanza zero-regex X12/NDJSON streaming parser",
  "license": "BSL-1.1",
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node bin/generate.mjs",
    "generate:full": "node bin/generate.mjs --transactions 250000 --claims 4 --out data/claims.x12",
    "bench": "node --experimental-transform-types --max-old-space-size=25 bin/run.mjs",
    "smoke": "node bin/generate.mjs --transactions 2000 --claims 4 --out data/smoke.x12 && node --experimental-transform-types --max-old-space-size=25 bin/run.mjs data/smoke.x12",
    "compare": "node bin/compare.mjs --file data/claims.x12",
    "compare:capped": "node bin/compare.mjs --file data/claims.x12 --cap 25"
  },
  "dependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "node-x12": "^1.7.1",
    "x12-parser": "^1.3.0"
  }
}
